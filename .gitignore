# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Verpex PHP bridge staging (contains DB secrets)
verpex-api/
.clm-api-key.tmp

# bulky SEO source dumps (runtime uses src/data/seo/*.json)
seo/keyword-planner-ideas.csv
seo/keywords-all.csv
seo/live-sitemap-parsed.json
seo/live-sitemap.xml
seo/gsc-performance-24h.zip
seo/get-started.html
seo/packages-live.html
seo/index-schedule/logs/

# Local DB backups
backups/
